<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows the system splash screen: the launcher icon
         on windowSplashScreenBackground. Dark Mode on. This folder is needed
         because the night qualifier outranks the API level: without it,
         values-night/ would win over values-v31/ on Android 12+. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
