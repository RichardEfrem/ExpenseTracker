    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.6"
        android:pathData="M39,32h26a3,3 0,0 1,3 3v11h-32v-11a3,3 0,0 1,3 -3z" />
    <!-- Wallet body with the clasp cut out (even-odd). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M35,40h38a7,7 0,0 1,7 7v22a7,7 0,0 1,-7 7h-38a7,7 0,0 1,-7 -7v-22a7,7 0,0 1,7 -7z
            M62,50h8a4,4 0,0 1,4 4v8a4,4 0,0 1,-4 4h-8a4,4 0,0 1,-4 -4v-8a4,4 0,0 1,4 -4z" />
