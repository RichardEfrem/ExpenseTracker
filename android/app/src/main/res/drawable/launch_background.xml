<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen for Android 8–11: the app icon (teal circle + wallet)
     centred on the palette background. Sizes match the Android 12+ system
     splash (160dp icon circle, 240dp foreground canvas) so both look alike.
     Android 12+ uses the system splash instead (values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="@color/brand_gradient_start"
                android:endColor="@color/brand_gradient_end" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
